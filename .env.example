# ===== HERMES — Configuração (copie para .env e ajuste) =====

# Modo de acionamento
# "true" = tecla ENTER liga/desliga (bom para testes)
# "false" = usa wake word (openWakeWord)
HERMES_KEYBOARD_MODE=true
HERMES_WAKE_WORD_MODEL=hey_jarvis

# Áudio
HERMES_MAX_RECORDING_SECONDS=3600

# Transcrição (faster-whisper)
# Modelos: tiny, base, small, medium, large-v3
HERMES_WHISPER_MODEL=small
HERMES_WHISPER_DEVICE=cpu
HERMES_WHISPER_COMPUTE_TYPE=int8

HF_HUB_DISABLE_SYMLINKS_WARNING=1

# LLM
# provider: "ollama" (local/grátis) ou "openai"
HERMES_LLM_PROVIDER=ollama
HERMES_OLLAMA_MODEL=llama3.1
HERMES_OLLAMA_HOST=http://localhost:11434
HERMES_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Idioma do resumo
HERMES_SUMMARY_LANGUAGE=português
